<!-- FRAMEWORK -->
<section class="section alt" id="metod">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Method</p>
      <h2>Growth Reality Framework™</h2>
      <p class="section-desc">A structured approach, from data you can trust to decisions the whole leadership team stands behind.</p>
    </div>

    <div class="card-grid">
      <div class="card reveal">
        <span class="card-badge">Step 0</span>
        <h3>Measurement Validation</h3>
        <p class="card-desc">Before any analysis, we make sure your data exists and can be trusted.</p>
        <ul class="check-list">
          <li>KPIs</li>
          <li>CRM data</li>
          <li>Product analytics</li>
          <li>Revenue data</li>
          <li>Event tracking</li>
          <li>North Star Metric</li>
          <li>PMF indicators</li>
        </ul>
      </div>
      <div class="card reveal">
        <span class="card-badge">Step 1</span>
        <h3>Verify</h3>
        <p class="card-desc">We verify the company's most important assumptions.</p>
        <ul class="check-list">
          <li>Do we really have proven PMF?</li>
          <li>Have we identified the right customer segment?</li>
          <li>Do we know what actually drives growth?</li>
          <li>Is our North Star the right one?</li>
        </ul>
      </div>
      <div class="card reveal">
        <span class="card-badge">Step 2</span>
        <h3>Analyze</h3>
        <p class="card-desc">We analyse the relationships between:</p>
        <ul class="check-list">
          <li>Customer</li>
          <li>Product</li>
          <li>Market</li>
          <li>Revenue</li>
          <li>Retention</li>
          <li>Feature usage</li>
        </ul>
      </div>
      <div class="card reveal">
        <span class="card-badge">Step 3</span>
        <h3>Prioritize</h3>
        <p class="card-desc">We score:</p>
        <ul class="check-list">
          <li>Segments</li>
          <li>Markets</li>
          <li>Features</li>
          <li>Product areas</li>
          <li>Initiatives</li>
        </ul>
      </div>
      <div class="card reveal">
        <span class="card-badge">Step 4</span>
        <h3>Decide</h3>
        <p class="card-desc">Every initiative is placed in one of four categories:</p>
        <ul class="check-list">
          <li>Accelerate</li>
          <li>Validate</li>
          <li>Pause</li>
          <li>Stop</li>
        </ul>
      </div>
      <div class="card reveal">
        <span class="card-badge">Step 5</span>
        <h3>Align</h3>
        <p class="card-desc">We build alignment on:</p>
        <ul class="check-list">
          <li>KPIs</li>
          <li>Roadmap</li>
          <li>Priorities</li>
          <li>Budget</li>
          <li>Resources</li>
        </ul>
      </div>
    </div>
  </div>
</section>

