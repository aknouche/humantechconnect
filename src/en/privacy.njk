        <span>I have read the information above and consent to HumanTechConnect AB processing my personal data to assess my application and match me with assignments.</span>
      </label>
      <a href="{{ i18n.careersFormUrl }}" class="btn btn-primary" id="consentBtn" aria-disabled="true">Accept and continue to the application</a>
    </div>
  </div>
</section>
