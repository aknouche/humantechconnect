{%- set lang = lang or "sv" -%}
{%- set t = i18n[lang] -%}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} | HumanTechConnect</title>
<meta name="description" content="{{ description }}">
<link rel="alternate" hreflang="sv" href="/">
<link rel="alternate" hreflang="en" href="/en/">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Newsreader:ital@1&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<div class="noise"></div>

<header class="site-header" id="top">
  <div class="container header-inner">
    <a href="{{ t.home }}#top" class="logo">
      <span class="logo-mark" aria-hidden="true"></span>
      HumanTechConnect
    </a>

    <nav class="nav" id="nav">
      <a href="{{ t.home }}#metodik">{{ t.navMethod }}</a>
      <a href="{{ t.home }}#modeller">{{ t.navModels }}</a>
      <a href="{{ t.home }}#kontakt">{{ t.navContact }}</a>
      <a href="https://www.linkedin.com/company/humantechconnect-ab" target="_blank" rel="noopener">LinkedIn</a>
      <a href="{{ t.switchHref }}" class="lang-switch" hreflang="{{ 'en' if lang == 'sv' else 'sv' }}" lang="{{ 'en' if lang == 'sv' else 'sv' }}" title="{{ t.switchTitle }}" aria-label="{{ t.switchTitle }}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
        {{ t.switchLabel }}
      </a>
    </nav>

    <a href="{{ t.home }}#kontakt" class="btn btn-primary btn-small header-cta">{{ t.cta }}</a>

    <button class="nav-toggle" id="navToggle" aria-label="{{ t.menu }}" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<main>
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="{{ t.home }}#top" class="logo">
        <span class="logo-mark" aria-hidden="true"></span>
        HumanTechConnect
      </a>
      <p>{{ t.footerText }}</p>
    </div>

    <div class="footer-links">
      <span class="footer-links-title">{{ t.links }}</span>
      <a href="{{ t.home }}#metodik">{{ t.navMethod }}</a>
      <a href="{{ t.home }}#leverans">{{ t.navWhat }}</a>
      <a href="{{ t.home }}#modeller">{{ t.navModels }}</a>
      <a href="{{ t.home }}#kontakt">{{ t.navContact }}</a>
      <a href="{{ t.switchHref }}">{{ t.switchTitle }}</a>
    </div>

    <div class="footer-links">
      <span class="footer-links-title">{{ t.contact }}</span>
      <a href="tel:+46739172918">073-917 29 18</a>
      <a href="https://www.linkedin.com/in/lamineaknouche/" target="_blank" rel="noopener">LinkedIn: Lamine Aknouche</a>
      <a href="https://www.linkedin.com/company/humantechconnect-ab" target="_blank" rel="noopener">LinkedIn: HumanTechConnect</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>&copy; <span id="year"></span> HumanTechConnect AB. {{ t.rights }}</p>
  </div>
</footer>

<script src="/js/main.js"></script>
</body>
</html>
