      <div class="card reveal">
        <span class="card-badge">Steg 3</span>
        <h3>Prioritize</h3>
        <p class="card-desc">Vi poängsätter:</p>
        <ul class="check-list">
          <li>Segment</li>
          <li>Marknader</li>
          <li>Features</li>
          <li>Produktområden</li>
          <li>Initiativ</li>
